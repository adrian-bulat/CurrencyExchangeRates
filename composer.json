{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bpampuch/pdfmake": "^0.2.20",
        "components/jquery": "^3.7",
        "datatables.net/datatables.net-buttons-dt": "^3.2",
        "datatables.net/datatables.net-colreorder-dt": "^2.1",
        "datatables.net/datatables.net-datetime": "^1.5",
        "datatables.net/datatables.net-dt": "^2.3",
        "datatables.net/datatables.net-fixedcolumns-dt": "^5.0",
        "datatables.net/datatables.net-fixedheader-dt": "^4.0",
        "datatables.net/datatables.net-responsive-dt": "^3.0",
        "datatables.net/datatables.net-rowreorder-dt": "^1.5",
        "datatables.net/datatables.net-scroller-dt": "^2.4",
        "datatables.net/datatables.net-searchbuilder-dt": "^1.8",
        "datatables.net/datatables.net-searchpanes-dt": "^2.3",
        "filament/filament": "^3.0",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.6",
        "stuk/jszip": "^3.0",
        "tymon/jwt-auth": "^2.2",
        "yajra/laravel-datatables-oracle": "^10.3.1"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
        ,
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
